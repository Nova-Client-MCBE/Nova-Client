{
  "namespace": "Nova_client_button",

  "tinted_button@common.button": {
    "locked_control": "locked",
    "$tint_default|default": [1, 1, 1],
    "$tint_hover|default": [1, 1, 1],
    "$tint_pressed|default": [1, 1, 1],
    "$tint_locked|default": [1, 1, 1],
    "controls": [
      {
        "default@Nova_client_button.default": {
          "$default_texture": ".NC/textures/buttons/base/button_default",
          "$overlay_texture": ".NC/textures/buttons/base/button_default_overlay",
          "alpha": "$gray_button_alpha",
          "$gray_button_alpha|default": 1
        }
      },
      {
        "hover@Nova_client_button.hover": {
          "$hover_texture": ".NC/textures/buttons/base/button_default",
          "$overlay_texture": ".NC/textures/buttons/base/button_default_overlay"
        }
      },
      {
        "pressed@Nova_client_button.pressed": {
          "$pressed_texture": ".NC/textures/buttons/base/button_pressed",
          "$overlay_texture": ".NC/textures/buttons/base/button_pressed_overlay",
          "$button_text_offset": [0, 1]
        }
      },
      {
        "locked@Nova_client_button.locked": {
          "$locked_texture": ".NC/textures/buttons/base/button_pressed",
          "$overlay_texture": ".NC/textures/buttons/base/button_pressed_overlay",
          "$button_text_offset": [0, 1]
        }
      }
    ]
  },

  "ore_ui_button@Nova_client_button.tinted_button": {
    "$tint_default": [0.816, 0.820, 0.831],
    "$tint_hover": [0.957, 0.965, 0.976],
    "$tint_pressed": [0.235, 0.522, 0.153],
    "$tint_locked": [0.235, 0.522, 0.153]
  },
  "gray_button@Nova_client_button.tinted_button": {
    "$tint_default": [0.184, 0.184, 0.188],
    "$tint_hover": [0.404, 0.408, 0.416],
    "$tint_pressed": [0.192, 0.196, 0.200],
    "$tint_locked": [0.192, 0.196, 0.200]
  },
  "red_button@Nova_client_button.tinted_button": {
    "sound_name": "NC.click",
    "$tint_default": [0.792, 0.212, 0.212],
    "$tint_hover": [0.996, 0.502, 0.506],
    "$tint_pressed": [0.749, 0.176, 0.176],
    "$tint_locked": [0.749, 0.176, 0.176]
  },
  "green_button@Nova_client_button.tinted_button": {
    "sound_name": "NC.click",
    "$font_type": "MinecraftTen",
    "$tint_default": [0.235, 0.522, 0.153],
    "$tint_hover": [0.322, 0.647, 0.208],
    "$tint_pressed": [0.165, 0.392, 0.110],
    "$tint_locked": [0.165, 0.392, 0.110]
  },
  "pink_button@Nova_client_button.tinted_button": {
    "sound_name": "NC.click",
    "$tint_default": [0.984, 0.584, 0.886],
    "$tint_hover": [1.000, 0.694, 0.925],
    "$tint_pressed": [0.973, 0.467, 0.863],
    "$tint_locked": [0.973, 0.467, 0.863]
  },

  "clear_button@common.button": {
    "locked_control": "locked",
    "controls": [
      {
        "default@Nova_client_button.default": {
          "$default_texture": "textures/ui/hud_tip_text_background",
          "alpha": 0
        }
      },
      {
        "hover@Nova_client_button.hover": {
          "$hover_texture": "textures/ui/hud_tip_text_background",
          "alpha": 0.6,
          "$text_color": [1, 1, 1]
        }
      },
      {
        "pressed@Nova_client_button.pressed": {
          "$pressed_texture": "textures/ui/Black",
          "alpha": 0.6,
          "$text_color": [1, 1, 1]
        }
      },
      {
        "locked@Nova_client_button.locked": {
          "$locked_texture": "textures/ui/Black",
          "alpha": 0.6
        }
      }
    ]
  },
  "white_border@common.button": {
    "locked_control": "locked",
    "sound_volume": 0.0,
    "controls": [
      {
        "default@Nova_client_button.default": {
          "$default_texture": "textures/ui/Black",
          "alpha": 0.4,
          "$text_color": [1, 1, 1]
        }
      },
      {
        "hover@Nova_client_button.hover": {
          "$hover_texture": "textures/ui/focus_border_white",
          "$text_color": [1, 1, 1]
        }
      },
      {
        "pressed@Nova_client_button.pressed": {
          "$pressed_texture": "textures/ui/focus_border_white",
          "$text_color": [1, 1, 1]
        }
      },
      {
        "locked@Nova_client_button.locked": {
          "$locked_texture": "textures/ui/Black",
          "alpha": 0.2,
          "$text_color": [1, 1, 1]
        }
      }
    ]
  },

  "default@Nova_client_button.button_content": {
    "$default": true,
    "texture": "$default_texture",
    "color": "$tint_default",
    "$tint_default|default": [1, 1, 1],
    "$overlay_control": "Nova_client_button.button_overlay_default"
  },
  "hover@Nova_client_button.button_content": {
    "$hover": true,
    "texture": "$hover_texture",
    "color": "$tint_hover",
    "$tint_hover|default": [1, 1, 1]
  },
  "pressed@Nova_client_button.button_content": {
    "$pressed": true,
    "texture": "$pressed_texture",
    "color": "$tint_pressed",
    "$tint_pressed|default": [1, 1, 1]
  },
  "locked@Nova_client_button.button_content": {
    "$locked": true,
    "texture": "$locked_texture",
    "color": "$tint_locked",
    "$tint_locked|default": [1, 1, 1]
  },

  "button_overlay": {
    "type": "image",
    "texture": "$overlay_texture",
    "$overlay_texture|default": ".NC/textures/invis",
    "size": ["100%", "100%"],
    "layer": 1
  },
  "button_overlay_default": {
    "type": "image",
    "texture": "$overlay_texture",
    "$overlay_texture|default": ".NC/textures/invis",
    "alpha": "$gray_button_alpha",
    "$gray_button_alpha|default": 1,
    "size": ["100%", "100%"],
    "layer": 1
  },

  "button_content": {
    "type": "image",
    "$overlay_control|default": "Nova_client_button.button_overlay",
    "$default|default": false,
    "$hover|default": false,
    "$pressed|default": false,
    "$locked|default": false,
    "$custom_content|default": "Nova_client_button.button_label",
    "bindings": "$button_bindings",
    "$button_bindings|default": [],
    "controls": [
      {
        "overlay@$overlay_control": {}
      },
      {
        "custom_content@$custom_content": {}
      }
    ]
  },
  "button_content_icon": {
    "type": "image",
    "$default|default": false,
    "$hover|default": false,
    "$pressed|default": false,
    "bindings": "$button_bindings",
    "$button_bindings|default": [],
    "controls": [
      {
        "label@Nova_client_button.label_icon": {}
      }
    ]
  },
  "label_icon": {
    "type": "panel",
    "layer": 15,
    "$NC_icon|default": "realms",
    "$NC_button_text|default": "\u00a7cMissing Text",
    "controls": [
      {
        "icon": {
          "type": "image",
          "texture": "('textures/ui/sidebar_icons/' + $NC_icon)",
          "layer": 13,
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "size": [16, 16],
          "offset": [3, 1]
        }
      },
      {
        "label": {
          "type": "label",
          "text": "$NC_button_text",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "layer": 13,
          "color": [1, 1, 1],
          "offset": [24, 1.3]
        }
      }
    ]
  },
  "button_icon": {
    "layer": 2,
    "texture": "$button_icon",
    "type": "image",
    "size": "$button_icon_size",
    "$button_icon_size|default": [15, 15],
    "bindings": "$button_bindings",
    "$button_bindings|default": []
  },
  "button_label": {
    "type": "label",
    "text": "$button_text",
    "$button_text|default": "",
    "shadow": "$shadow",
    "$shadow|default": false,
    "font_scale_factor": "$font_scale_factor",
    "$font_scale_factor|default": 1,
    "layer": 10,
    "font_type": "$font_type",
    "$font_type|default": "default",
    "size": ["default", "default"],
    "color": "$text_color",
    "$text_color|default": [0.3, 0.3, 0.3],
    "offset": "$button_text_offset",
    "$button_text_offset|default": [0, 0]
  },
  "label_hover_text": {
    "type": "panel",
    "$button_content_hover_text|default": "Nova_client_button.button_label",
    "controls": [
      {
        "1@Nova_Client_common.hover_text_template": {}
      },
      {
        "2@$button_content_hover_text": {}
      }
    ]
  }
}
