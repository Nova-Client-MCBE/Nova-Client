    "controls": [
      {
        "@item_aux_viewer": {}
      }
    ]
  },
  "item_aux_viewer": {
    "type": "label",
    "layer": 2,
    "shadow": true,
    "text": "#nc_txt",
    "bindings": [
      {
        "binding_name": "#item_id_aux",
        "binding_type": "collection",
        "binding_collection_name": "hotbar_items"
      },
      {
        "binding_type": "view",
        "source_property_name": "('Aux ID: ' + #item_id_aux)",
        "target_property_name": "#text"
      },
      {
        "binding_type": "view",
        "source_property_name": "('Aux ID: ' + (not (#item_id_aux = -1)))",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_item_info_size_eff",
