{
  "namespace": "Nova_Client_item_info_panel",
  "content": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [
      "100%c",
      "100%c"
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "item_information_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "name_panel": {
          "type": "panel",
          "size": [
            "100%c",
            "100%c"
          ],
          "controls": [
            {
              "item_name@Nova_Client_common.black": {
                "$black_size": [
                  "100%c +4px",
                  "100%c +4px"
                ],
                "anchor_from": "right_middle",
                "anchor_to": "right_middle",
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "item_info_opacity",
                    "source_property_name": "(#slider_value / 10)",
                    "target_property_name": "#alpha"
                  },
                  {
                    "binding_type": "view",
                    "source_control_name": "item_info_item_name",
                    "source_property_name": "#toggle_state",
                    "target_property_name": "#visible"
                  }
                ],
                "controls": [
                  {
                    "text": {
                      "type": "label",
                      "layer": 2,
                      "text": "#nc_txt",
                      "shadow": true,
                      "property_bag": {
                        "force_update": true
                      },
                      "bindings": [
                        {
                          "binding_name": "#item_text"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "('Item Name: ' + #item_text)",
                          "target_property_name": "#name"
                        },
                        {
                          "binding_type": "view",
                          "source_control_name": "nc_item_info_size_eff",
                          "source_property_name": "(((#nc_eff + 10) * 1) / 20)",
                          "target_property_name": "#font_scale_factor"
                        },
                        {
                          "binding_type": "view",
                          "source_control_name": "nc_item_info_size_eff",
                          "source_property_name": "#nc_eff",
                          "target_property_name": "#nc_fe"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "((#nc_fe > 9) + (#nc_fe > 19) + (#nc_fe > 29))",
                          "target_property_name": "#nc_fq"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(#nc_fe - (#nc_fq * 10))",
                          "target_property_name": "#nc_fr"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "((#nc_fr > 0) + (#nc_fr > 1) + (#nc_fr > 2) + (#nc_fr > 3) + (#nc_fr > 4) + (#nc_fr > 5) + (#nc_fr > 6) + (#nc_fr > 7) + (#nc_fr > 8))",
                          "target_property_name": "#nc_fk"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "('§' + #nc_fq + '§' + #nc_fk)",
                          "target_property_name": "#nc_sfx"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "('' + #name + #nc_sfx)",
                          "target_property_name": "#nc_txt"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "aux_panel": {
          "type": "panel",
          "size": [
            "100%c",
            "100%c"
          ],
          "controls": [
            {
              "item_aux@item_aux": {
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "item_aux_id",
                    "source_property_name": "#toggle_state",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "id_panel": {
          "type": "panel",
          "size": [
            "100%c",
            "100%c"
          ],
          "controls": [
            {
              "item_id@item_id": {
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "item_id_toggle",
                    "source_property_name": "#toggle_state",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "item_id": {
    "type": "stack_panel",
    "collection_name": "hotbar_items",
    "size": [
      "100%cm",
      "100%c"
    ],
    "controls": [
      {
        "@item_id_panel": {
          "collection_index": 0
        }
      },
      {
        "@item_id_panel": {
          "collection_index": 1
        }
      },
      {
        "@item_id_panel": {
          "collection_index": 2
        }
      },
      {
        "@item_id_panel": {
          "collection_index": 3
        }
      },
      {
        "@item_id_panel": {
          "collection_index": 4
        }
      },
      {
        "@item_id_panel": {
          "collection_index": 5
        }
      },
      {
        "@item_id_panel": {
          "collection_index": 6
        }
      },
      {
        "@item_id_panel": {
          "collection_index": 7
        }
      },
      {
        "@item_id_panel": {
          "collection_index": 8
        }
      }
    ]
  },
  "item_id_panel": {
    "type": "panel",
    "size": [
      "100%cm",
      "100%cm"
    ],
    "bindings": [
      {
        "binding_name": "#slot_selected",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "hotbar_items"
      }
    ],
    "controls": [
      {
        "@item_id_bg": {}
      }
    ]
  },
  "item_id_bg@Nova_Client_common.black": {
    "$black_size": [
      "100%c +4px",
      "100%c +4px"
    ],
    "bindings": [
      {
        "binding_name": "#item_id_aux",
        "binding_type": "collection",
        "binding_collection_name": "hotbar_items"
      },
      {
        "binding_type": "view",
        "source_control_name": "item_info_opacity",
        "source_property_name": "(#slider_value / 10)",
        "target_property_name": "#alpha"
      }
    ],
    "controls": [
      {
        "@item_id_viewer": {}
      },
      {
        "item_id_viewer_negative": {
          "type": "label",
          "layer": 2,
          "shadow": true,
          "text": "#nc_txt",
          "bindings": [
            {
              "binding_name": "#item_id_aux",
              "binding_type": "collection",
              "binding_collection_name": "hotbar_items"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#item_id_aux = -1)",
              "target_property_name": "#visible"
            },
            {
              "binding_type": "view",
              "source_control_name": "nc_item_info_size_eff",
              "source_property_name": "(((#nc_eff + 10) * 1) / 20)",
              "target_property_name": "#font_scale_factor"
            },
            {
              "binding_type": "view",
              "source_control_name": "nc_item_info_size_eff",
              "source_property_name": "#nc_eff",
              "target_property_name": "#nc_fe"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#nc_fe > 9) + (#nc_fe > 19) + (#nc_fe > 29))",
              "target_property_name": "#nc_fq"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#nc_fe - (#nc_fq * 10))",
              "target_property_name": "#nc_fr"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#nc_fr > 0) + (#nc_fr > 1) + (#nc_fr > 2) + (#nc_fr > 3) + (#nc_fr > 4) + (#nc_fr > 5) + (#nc_fr > 6) + (#nc_fr > 7) + (#nc_fr > 8))",
              "target_property_name": "#nc_fk"
            },
            {
              "binding_type": "view",
              "source_property_name": "('§' + #nc_fq + '§' + #nc_fk)",
              "target_property_name": "#nc_sfx"
            },
            {
              "binding_type": "view",
              "source_property_name": "('' + '§fItem ID: -1' + #nc_sfx)",
              "target_property_name": "#nc_txt"
            }
          ]
        }
      }
    ]
  },
  "item_id_viewer": {
    "type": "label",
    "layer": 2,
    "shadow": true,
    "text": "#nc_txt",
    "bindings": [
      {
        "binding_name": "#item_id_aux",
        "binding_type": "collection",
        "binding_collection_name": "hotbar_items"
      },
      {
        "binding_type": "view",
        "source_property_name": "('Item ID: ' + (#item_id_aux / 65536))",
        "target_property_name": "#text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#item_id_aux = -1))",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_item_info_size_eff",
        "source_property_name": "(((#nc_eff + 10) * 1) / 20)",
        "target_property_name": "#font_scale_factor"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_item_info_size_eff",
        "source_property_name": "#nc_eff",
        "target_property_name": "#nc_fe"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#nc_fe > 9) + (#nc_fe > 19) + (#nc_fe > 29))",
        "target_property_name": "#nc_fq"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#nc_fe - (#nc_fq * 10))",
        "target_property_name": "#nc_fr"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#nc_fr > 0) + (#nc_fr > 1) + (#nc_fr > 2) + (#nc_fr > 3) + (#nc_fr > 4) + (#nc_fr > 5) + (#nc_fr > 6) + (#nc_fr > 7) + (#nc_fr > 8))",
        "target_property_name": "#nc_fk"
      },
      {
        "binding_type": "view",
        "source_property_name": "('§' + #nc_fq + '§' + #nc_fk)",
        "target_property_name": "#nc_sfx"
      },
      {
        "binding_type": "view",
        "source_property_name": "('' + #text + #nc_sfx)",
        "target_property_name": "#nc_txt"
      }
    ]
  },
  "item_aux": {
    "type": "stack_panel",
    "collection_name": "hotbar_items",
    "size": [
      "100%cm",
      "100%c"
    ],
    "controls": [
      {
        "@item_aux_panel": {
          "collection_index": 0
        }
      },
      {
        "@item_aux_panel": {
          "collection_index": 1
        }
      },
      {
        "@item_aux_panel": {
