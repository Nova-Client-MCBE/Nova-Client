{
  "namespace": "Nova_Client_day_counter",
  "content": {
    "type": "image",
    "size": [
      "100%c + 6px",
      "100%c + 2px"
    ],
    "texture": "textures/ui/Black",
    "alpha": 0.5,
    "layer": 1,
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "day_counter_toggle",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_control_name": "day_counter_opacity",
        "source_property_name": "(#slider_value / 10)",
        "target_property_name": "#alpha"
      }
    ],
    "controls": [
      {
        "number_of_days_played_text": {
          "type": "label",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "layer": 2,
          "enable_profanity_filter": false,
          "color": "$chat_text_color",
          "text": "#nc_txt",
          "shadow": true,
          "bindings": [
            {
              "binding_name": "#number_of_days_played_text",
              "binding_name_override": "#text",
              "binding_condition": "always_when_visible",
              "binding_type": "global"
            },
            {
              "binding_type": "view",
              "source_control_name": "nc_day_counter_size_eff",
              "source_property_name": "(((#nc_eff + 10) * 1) / 20)",
              "target_property_name": "#font_scale_factor"
            },
            {
              "binding_type": "view",
              "source_control_name": "nc_day_counter_size_eff",
              "source_property_name": "#nc_eff",
              "target_property_name": "#nc_fe"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#nc_fe > 9) + (#nc_fe > 19) + (#nc_fe > 29))",
              "target_property_name": "#nc_fq"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#nc_fe - (#nc_fq * 10))",
              "target_property_name": "#nc_fr"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#nc_fr > 0) + (#nc_fr > 1) + (#nc_fr > 2) + (#nc_fr > 3) + (#nc_fr > 4) + (#nc_fr > 5) + (#nc_fr > 6) + (#nc_fr > 7) + (#nc_fr > 8))",
              "target_property_name": "#nc_fk"
            },
            {
              "binding_type": "view",
              "source_property_name": "('§' + #nc_fq + '§' + #nc_fk)",
              "target_property_name": "#nc_sfx"
            },
            {
              "binding_type": "view",
              "source_property_name": "('' + #text + #nc_sfx)",
              "target_property_name": "#nc_txt"
            }
          ]
        }
      },
      {
        "number_of_days_played_text_off": {
          "type": "label",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "layer": 2,
          "enable_profanity_filter": false,
          "text": "#nc_txt",
          "shadow": true,
          "bindings": [
            {
              "binding_name": "(not #number_of_days_played_visible)",
              "binding_name_override": "#visible",
              "binding_condition": "always",
              "binding_type": "global"
            },
            {
              "binding_type": "view",
              "source_control_name": "nc_day_counter_size_eff",
              "source_property_name": "(((#nc_eff + 10) * 1) / 20)",
              "target_property_name": "#font_scale_factor"
            },
            {
              "binding_type": "view",
              "source_control_name": "nc_day_counter_size_eff",
              "source_property_name": "#nc_eff",
              "target_property_name": "#nc_fe"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#nc_fe > 9) + (#nc_fe > 19) + (#nc_fe > 29))",
              "target_property_name": "#nc_fq"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#nc_fe - (#nc_fq * 10))",
              "target_property_name": "#nc_fr"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#nc_fr > 0) + (#nc_fr > 1) + (#nc_fr > 2) + (#nc_fr > 3) + (#nc_fr > 4) + (#nc_fr > 5) + (#nc_fr > 6) + (#nc_fr > 7) + (#nc_fr > 8))",
              "target_property_name": "#nc_fk"
            },
            {
              "binding_type": "view",
              "source_property_name": "('§' + #nc_fq + '§' + #nc_fk)",
              "target_property_name": "#nc_sfx"
            },
            {
              "binding_type": "view",
              "source_property_name": "('' + 'Days Played: §cDisabled' + #nc_sfx)",
              "target_property_name": "#nc_txt"
            }
          ]
        }
      }
    ]
  }
}
