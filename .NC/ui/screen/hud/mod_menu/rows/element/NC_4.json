{
  "namespace": "Nova_Client_element_row_four",
  "content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [
      "100%",
      75
    ],
    "controls": [
      {
        "spacer@Nova_Client_common.spacer": {}
      },
      {
        "tips@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/ui/blue_info_glyph",
          "$toggle_view_binding_name": "tip_text_toggle",
          "$toggle_tags": "$tip_text",
          "$modules_template_toggle_text": "Tips",
          "$modules_template_toggle_size": [
            "100%",
            20
          ],
          "$modules_template_button_size": [
            0,
            0
          ],
          "$button_icon_size": [
            0,
            0
          ],
          "$nc_letter_ctrl": "nc_ltr_t"
        }
      },
      {
        "spacer2@Nova_Client_common.spacer": {}
      },
      {
        "item_text@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/ui/text_color_paintbrush",
          "$toggle_view_binding_name": "item_text_toggle",
          "$toggle_tags": "$item_text",
          "$modules_template_toggle_text": "Item Text",
          "$modules_template_button_name": "button.item_text_screen",
          "$nc_letter_ctrl": "nc_ltr_i"
        }
      },
      {
        "spacer3@Nova_Client_common.spacer": {}
      },
      {
        "xp_bar@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/items/experience_bottle",
          "$toggle_view_binding_name": "xp_bar_toggle",
          "$toggle_tags": "$xp_bar",
          "$modules_template_toggle_text": "XP Bar",
          "$modules_template_button_name": "button.xp_bar_screen",
          "$nc_letter_ctrl": "nc_ltr_x"
        }
      }
    ],
    "property_bag": {
      "#nc_kb_off": true,
      "#nc_all": true,
      "#nc_l1": true,
      "#nc_l2": true,
      "#nc_l3": true
    },
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "keyboard_toggle",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#nc_kb_off"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_all",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_all"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_i",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l1"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_t",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l2"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_x",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l3"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#nc_kb_off or #nc_all or #nc_l1 or #nc_l2 or #nc_l3)",
        "target_property_name": "#visible"
      }
    ]
  }
}