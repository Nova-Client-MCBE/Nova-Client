{
  "namespace": "Nova_Client_element_row_five",
  "content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [
      "100%",
      75
    ],
    "controls": [
      {
        "spacer@Nova_Client_common.spacer": {}
      },
      {
        "hotbar@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/items/iron_sword",
          "$toggle_view_binding_name": "hotbar_toggle",
          "$toggle_tags": "$hotbar",
          "$modules_template_toggle_text": "Hotbar",
          "$modules_template_button_name": "button.hotbar_screen",
          "$nc_letter_ctrl": "nc_ltr_h"
        }
      },
      {
        "spacer2@Nova_Client_common.spacer": {}
      },
      {
        "sound_subtitles@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/ui/text_color_paintbrush",
          "$toggle_view_binding_name": "sound_subtitles_toggle",
          "$toggle_tags": "$sound_subtitles",
          "$modules_template_toggle_text": "Sound Subtitles",
          "$modules_template_button_name": "button.sound_subtitles_screen",
          "$nc_letter_ctrl": "nc_ltr_s"
        }
      },
      {
        "spacer3@Nova_Client_common.spacer": {}
      },
      {
        "f1@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/ui/switch_sl_button",
          "$toggle_view_binding_name": "f1_toggle",
          "$toggle_tags": "$f1_button",
          "$modules_template_toggle_text": "F1 Button",
          "$modules_template_toggle_size": [
            "100%",
            20
          ],
          "$modules_template_button_size": [
            0,
            0
          ],
          "$button_icon_size": [
            0,
            0
          ],
          "$nc_letter_ctrl": "nc_ltr_f"
        }
      }
    ],
    "property_bag": {
      "#nc_kb_off": true,
      "#nc_all": true,
      "#nc_l1": true,
      "#nc_l2": true,
      "#nc_l3": true
    },
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "keyboard_toggle",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#nc_kb_off"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_all",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_all"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_f",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l1"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_h",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l2"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_s",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l3"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#nc_kb_off or #nc_all or #nc_l1 or #nc_l2 or #nc_l3)",
        "target_property_name": "#visible"
      }
    ]
  }
}