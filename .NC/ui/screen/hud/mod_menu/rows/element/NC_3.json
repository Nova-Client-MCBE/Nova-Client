{
  "namespace": "Nova_Client_element_row_three",
  "content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [
      "100%",
      75
    ],
    "controls": [
      {
        "spacer1@Nova_Client_common.spacer": {}
      },
      {
        "action_bar@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/ui/text_color_paintbrush",
          "$toggle_view_binding_name": "action_bar_toggle",
          "$toggle_tags": "$action_bar",
          "$modules_template_toggle_text": "Action Bar",
          "$modules_template_toggle_size": [
            "100%",
            20
          ],
          "$modules_template_button_size": [
            0,
            0
          ],
          "$button_icon_size": [
            0,
            0
          ],
          "$nc_letter_ctrl": "nc_ltr_a"
        }
      },
      {
        "spacer2@Nova_Client_common.spacer": {}
      },
      {
        "subtitle@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/ui/text_color_paintbrush",
          "$toggle_view_binding_name": "subtitle_toggle",
          "$toggle_tags": "$subtitle",
          "$modules_template_toggle_text": "Subtitle",
          "$modules_template_toggle_size": [
            "100%",
            20
          ],
          "$modules_template_button_size": [
            0,
            0
          ],
          "$button_icon_size": [
            0,
            0
          ],
          "$nc_letter_ctrl": "nc_ltr_s"
        }
      },
      {
        "spacer3@Nova_Client_common.spacer": {}
      },
      {
        "jukebox@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/blocks/jukebox_side",
          "$toggle_view_binding_name": "jukebox_toggle",
          "$toggle_tags": "$jukebox_text",
          "$modules_template_toggle_text": "Jukebox Text",
          "$modules_template_button_name": "button.jukebox_screen",
          "$nc_letter_ctrl": "nc_ltr_j"
        }
      }
    ],
    "property_bag": {
      "#nc_kb_off": true,
      "#nc_all": true,
      "#nc_l1": true,
      "#nc_l2": true,
      "#nc_l3": true
    },
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "keyboard_toggle",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#nc_kb_off"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_all",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_all"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_a",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l1"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_j",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l2"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_s",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l3"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#nc_kb_off or #nc_all or #nc_l1 or #nc_l2 or #nc_l3)",
        "target_property_name": "#visible"
      }
    ]
  }
}