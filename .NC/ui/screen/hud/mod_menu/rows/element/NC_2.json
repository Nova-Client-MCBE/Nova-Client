{
  "namespace": "Nova_Client_element_row_two",
  "content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [
      "100%",
      75
    ],
    "controls": [
      {
        "spacer1@Nova_Client_common.spacer": {}
      },
      {
        "vignette@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/ui/blindness_effect",
          "$toggle_view_binding_name": "vignette_toggle",
          "$toggle_tags": "$vignette",
          "$modules_template_toggle_text": "Vignette",
          "$modules_template_toggle_size": [
            "100%",
            20
          ],
          "$modules_template_button_size": [
            0,
            0
          ],
          "$button_icon_size": [
            0,
            0
          ],
          "$nc_letter_ctrl": "nc_ltr_v"
        }
      },
      {
        "spacer2@Nova_Client_common.spacer": {}
      },
      {
        "chat@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/ui/chat_send",
          "$toggle_view_binding_name": "chat_toggle",
          "$toggle_tags": "$chat",
          "$modules_template_toggle_text": "Chat",
          "$modules_template_button_name": "button.chat_screen",
          "$nc_letter_ctrl": "nc_ltr_c"
        }
      },
      {
        "spacer3@Nova_Client_common.spacer": {}
      },
      {
        "title@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/ui/text_color_paintbrush",
          "$toggle_view_binding_name": "title_toggle",
          "$toggle_tags": "$title",
          "$modules_template_toggle_text": "Title",
          "$modules_template_toggle_size": [
            "100%",
            20
          ],
          "$modules_template_button_size": [
            0,
            0
          ],
          "$button_icon_size": [
            0,
            0
          ],
          "$nc_letter_ctrl": "nc_ltr_t"
        }
      }
    ],
    "property_bag": {
      "#nc_kb_off": true,
      "#nc_all": true,
      "#nc_l1": true,
      "#nc_l2": true,
      "#nc_l3": true
    },
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "keyboard_toggle",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#nc_kb_off"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_all",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_all"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_c",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l1"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_t",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l2"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_v",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l3"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#nc_kb_off or #nc_all or #nc_l1 or #nc_l2 or #nc_l3)",
        "target_property_name": "#visible"
      }
    ]
  }
}