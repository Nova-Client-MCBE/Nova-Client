{
  "namespace": "Nova_Client_modules_row_five",
  "content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [
      "100%",
      75
    ],
    "controls": [
      {
        "spacer1@Nova_Client_common.spacer": {}
      },
      {
        "xp_panel@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/items/experience_bottle",
          "$toggle_view_binding_name": "xp_panel_toggle",
          "$toggle_tags": "$exp_calculator",
          "$modules_template_toggle_text": "EXP Calculator",
          "$modules_template_button_name": "button.xp_calculator_screen",
          "$nc_letter_ctrl": "nc_ltr_e"
        }
      },
      {
        "spacer2@Nova_Client_common.spacer": {}
      },
      {
        "player_list@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/ui/glyph_inventory",
          "$toggle_view_binding_name": "player_list_toggle",
          "$toggle_tags": "$playerlist",
          "$modules_template_toggle_text": "Playerlist",
          "$modules_template_button_name": "button.playerlist_screen",
          "$nc_letter_ctrl": "nc_ltr_p"
        }
      },
      {
        "spacer3@Nova_Client_common.spacer": {}
      },
      {
        "moon_phase@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": ".NC/textures/modules/moon/moon_phase_0",
          "$toggle_view_binding_name": "moon_phase_toggle",
          "$toggle_tags": "$moon_phase",
          "$modules_template_toggle_text": "Moon Phase",
          "$modules_template_button_name": "button.moon_phase_screen",
          "$nc_letter_ctrl": "nc_ltr_m"
        }
      }
    ],
    "property_bag": {
      "#nc_kb_off": true,
      "#nc_all": true,
      "#nc_l1": true,
      "#nc_l2": true,
      "#nc_l3": true
    },
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "keyboard_toggle",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#nc_kb_off"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_all",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_all"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_e",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l1"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_m",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l2"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_p",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l3"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#nc_kb_off or #nc_all or #nc_l1 or #nc_l2 or #nc_l3)",
        "target_property_name": "#visible"
      }
    ]
  }
}