{
  "namespace": "Nova_Client_modules_row_four",
  "content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [
      "100%",
      75
    ],
    "controls": [
      {
        "spacer1@Nova_Client_common.spacer": {}
      },
      {
        "paperdoll@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/ui/profile_glyph_color",
          "$toggle_view_binding_name": "3d_paper_doll_toggle",
          "$toggle_tags": "$paperdoll",
          "$modules_template_toggle_text": "Paperdoll",
          "$modules_template_button_name": "button.paperdoll_screen",
          "$nc_letter_ctrl": "nc_ltr_p",
          "$nc_page_toggle": "nc_page_paperdoll",
          "$nc_page_index": 10
        }
      },
      {
        "spacer2@Nova_Client_common.spacer": {}
      },
      {
        "iteminfo@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/items/stick",
          "$toggle_view_binding_name": "item_information_toggle",
          "$toggle_tags": "$item_info",
          "$modules_template_toggle_text": "Item Info",
          "$modules_template_button_name": "button.item_info_screen",
          "$nc_letter_ctrl": "nc_ltr_i",
          "$nc_page_toggle": "nc_page_item_info",
          "$nc_page_index": 11
        }
      },
      {
        "spacer3@Nova_Client_common.spacer": {}
      },
      {
        "xp_panel@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/items/experience_bottle",
          "$toggle_view_binding_name": "xp_panel_toggle",
          "$toggle_tags": "$exp_calculator",
          "$modules_template_toggle_text": "EXP Calculator",
          "$modules_template_button_name": "button.xp_calculator_screen",
          "$nc_letter_ctrl": "nc_ltr_e",
          "$nc_page_toggle": "nc_page_xp_calculator",
          "$nc_page_index": 12
        }
      }
    ],
    "property_bag": {
      "#nc_kb_off": true,
      "#nc_all": true,
      "#nc_l1": true,
      "#nc_l2": true,
      "#nc_l3": true
    },
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "keyboard_toggle",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#nc_kb_off"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_all",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_all"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_b",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l1"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_i",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l2"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_p",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l3"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#nc_kb_off or #nc_all or #nc_l1 or #nc_l2 or #nc_l3)",
        "target_property_name": "#visible"
      }
    ]
  }
}
