{
  "namespace": "Nova_Client_modules_row_three",
  "content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [
      "100%",
      75
    ],
    "controls": [
      {
        "spacer1@Nova_Client_common.spacer": {}
      },
      {
        "coords@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/ui/xyz_axis",
          "$toggle_view_binding_name": "coords_toggle",
          "$toggle_tags": "$coordinates",
          "$modules_template_toggle_text": "Coordinates",
          "$modules_template_button_name": "button.coordinates_screen",
          "$nc_letter_ctrl": "nc_ltr_c"
        }
      },
      {
        "spacer2@Nova_Client_common.spacer": {}
      },
      {
        "crosshair@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": ".NC/textures/modules/crosshair",
          "$toggle_view_binding_name": "crosshair_toggle",
          "$toggle_tags": "$crosshair",
          "$modules_template_toggle_text": "Crosshair",
          "$modules_template_button_name": "button.crosshair_screen",
          "$nc_letter_ctrl": "nc_ltr_c"
        }
      },
      {
        "spacer3@Nova_Client_common.spacer": {}
      },
      {
        "inventory_slot@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/ui/inventory_icon",
          "$toggle_view_binding_name": "inventory_slot_counter_toggle",
          "$toggle_tags": "$inventory_slot_counter",
          "$modules_template_toggle_text": "Inventory Slots",
          "$modules_template_button_name": "button.inventory_slot_counter_screen",
          "$nc_letter_ctrl": "nc_ltr_i"
        }
      }
    ],
    "property_bag": {
      "#nc_kb_off": true,
      "#nc_all": true,
      "#nc_l1": true,
      "#nc_l2": true
    },
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "keyboard_toggle",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#nc_kb_off"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_all",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_all"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_c",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l1"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_i",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l2"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#nc_kb_off or #nc_all or #nc_l1 or #nc_l2)",
        "target_property_name": "#visible"
      }
    ]
  }
}