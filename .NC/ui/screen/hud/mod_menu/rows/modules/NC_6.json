{
  "namespace": "Nova_Client_modules_row_six",
  "content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [
      "100%",
      75
    ],
    "controls": [
      {
        "spacer1@Nova_Client_common.spacer": {}
      },
      {
        "shiny_potions@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/items/potion_bottle_heal",
          "$toggle_view_binding_name": "shiny_potions_toggle",
          "$toggle_tags": "$shiny_potions",
          "$modules_template_toggle_text": "Shiny Potions",
          "$modules_template_button_name": "button.shiny_potions_screen",
          "$nc_letter_ctrl": "nc_ltr_s",
          "$nc_page_toggle": "nc_page_shiny_potions",
          "$nc_page_index": 24
        }
      },
      {
        "spacer2@Nova_Client_common.spacer": {}
      },
      {
        "keyboard@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": ".NC/textures/modules/keyboard",
          "$toggle_view_binding_name": "keyboard_toggle",
          "$toggle_tags": "$keyboard",
          "$modules_template_toggle_text": "Keyboard",
          "$modules_template_toggle_size": [
            "100%",
            20
          ],
          "$modules_template_button_size": [
            0,
            0
          ],
          "$button_icon_size": [
            0,
            0
          ],
          "$nc_letter_ctrl": "nc_ltr_k",
          "$nc_no_page": true
        }
      },
      {
        "spacer3@Nova_Client_common.spacer": {}
      },
      {
        "held_item_total@Nova_client_modules_menu_button_template.content": {
          "$modules_template_texture": "textures/items/diamond",
          "$toggle_view_binding_name": "held_item_total_toggle",
          "$toggle_tags": "$held_item_total",
          "$modules_template_toggle_text": "Held Item Total",
          "$modules_template_button_name": "button.held_item_total_screen",
          "$nc_letter_ctrl": "nc_ltr_h",
          "$nc_page_toggle": "nc_page_held_item_total",
          "$nc_page_index": 25
        }
      }
    ],
    "property_bag": {
      "#nc_kb_off": true,
      "#nc_all": true,
      "#nc_l1": true,
      "#nc_l2": true,
      "#nc_l3": true
    },
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "keyboard_toggle",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#nc_kb_off"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_all",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_all"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_a",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l1"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_k",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l2"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_s",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_l3"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#nc_kb_off or #nc_all or #nc_l1 or #nc_l2 or #nc_l3)",
        "target_property_name": "#visible"
      }
    ]
  }
}
