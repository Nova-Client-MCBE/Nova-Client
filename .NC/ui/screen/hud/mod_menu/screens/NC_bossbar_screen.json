{
  "namespace": "Nova_Client_bossbar_screen",
  "content@Nova_Client_layout.page_body": {
    "$nc_page_toggle": "nc_page_bossbar",
    "$nc_page_desc": "The health bar of bosses. \"Percent\" also shows the health as a number.",
    "$nc_page_req": "Only appears while a boss is nearby.",
    "$nc_page_no_req": false,
    "$nc_page_rows": [
      {
        "row_1": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "1@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "bossbar_percent_toggle",
                "$toggle_tags": "$bossbar_percent",
                "$NC_dialog_toggle_text": "Percent",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "opacity_slider@Nova_Client_common.opacity_slider_section": {
          "$NC_opacity_slider_name": "bossbar_opacity",
          "$NC_opacity_default_value": "$bossbar_percent_opacity",
          "$NC_slider_section_offset": [
            0,
            0
          ]
        }
      }
    ]
  }
}
