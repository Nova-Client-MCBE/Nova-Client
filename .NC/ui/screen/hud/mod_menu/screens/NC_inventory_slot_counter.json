{
  "namespace": "Nova_Client_inventory_slot_counter_screen",
  "content@Nova_Client_layout.page_body": {
    "$nc_page_toggle": "nc_page_inventory_slot_counter",
    "$nc_page_desc": "Shows how many inventory slots are still free. The number turns red when all 36 slots are used, \"Full Warning\" also shows a warning above the hotbar.",
    "$nc_page_req": "",
    "$nc_page_no_req": true,
    "$nc_page_rows": [
      {
        "row_1": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "1@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "inventory_slot_counter_icon_toggle",
                "$toggle_tags": "$inventory_slot_counter_icon",
                "$NC_dialog_toggle_text": "Icon",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "opacity_slider@Nova_Client_common.opacity_slider_section": {
          "$NC_opacity_slider_name": "inv_slot_opacity",
          "$NC_opacity_default_value": "$inventory_slot_opacity",
          "$NC_slider_section_offset": [
            0,
            0
          ]
        }
      },
      {
        "row_inventory_full_warning": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "1@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "inventory_full_warning",
                "$toggle_tags": "$inventory_full_warning",
                "$NC_dialog_toggle_text": "Full Warning",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "inventory_full_warning_opacity_row@Nova_Client_common.opacity_slider_section": {
          "$NC_opacity_slider_name": "inventory_full_warning_opacity",
          "$NC_opacity_default_value": "$inventory_full_warning_opacity",
          "$NC_slider_section_offset": [
            0,
            0
          ],
          "$NC_opacity_title": "Warning Opacity"
        }
      },
      {
        "pos_gap@Nova_Client_common.spacer": {
          "$NC_spacer_size": [
            8,
            8
          ]
        }
      },
      {
        "pos_title": {
          "type": "label",
          "text": "§lPosition & Size",
          "color": [
            1,
            1,
            1
          ],
          "shadow": false,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle"
        }
      },
      {
        "pos_gap2@Nova_Client_common.spacer": {
          "$NC_spacer_size": [
            4,
            4
          ]
        }
      },
      {
        "nc_inventory_slot_counter_x_row@Nova_Client_layout.value_slider": {
          "$nc_vs_name": "nc_inventory_slot_counter_x",
          "$nc_vs_caption": "X",
          "$nc_vs_steps": 101,
          "$nc_vs_cfg": "$inventory_slot_counter_x",
          "$nc_vs_init_expr": "((#slider_steps * 0) + #nc_cfg)",
          "$nc_vs_mul": 1,
          "$nc_vs_add": 0,
          "$nc_vs_unit": "%"
        }
      },
      {
        "nc_inventory_slot_counter_y_row@Nova_Client_layout.value_slider": {
          "$nc_vs_name": "nc_inventory_slot_counter_y",
          "$nc_vs_caption": "Y",
          "$nc_vs_steps": 101,
          "$nc_vs_cfg": "$inventory_slot_counter_y",
          "$nc_vs_init_expr": "((#slider_steps * 0) + #nc_cfg)",
          "$nc_vs_mul": 1,
          "$nc_vs_add": 0,
          "$nc_vs_unit": "%"
        }
      },
      {
        "nc_inventory_slot_counter_size_row@Nova_Client_layout.value_slider": {
          "$nc_vs_name": "nc_inventory_slot_counter_size",
          "$nc_vs_caption": "Size",
          "$nc_vs_steps": 31,
          "$nc_vs_cfg": "$inventory_slot_counter_size",
          "$nc_vs_init_expr": "((((#slider_steps * 0) + #nc_cfg) - 50) / 5)",
          "$nc_vs_mul": 5,
          "$nc_vs_add": 50,
          "$nc_vs_unit": "%"
        }
      },
      {
        "cfg_hint": {
          "type": "label",
          "shadow": false,
          "font_scale_factor": 0.8,
          "color": [
            0.6,
            0.6,
            0.6
          ],
          "text": "Defaults are saved in config.json: inventory_slot_counter_x, inventory_slot_counter_y, inventory_slot_counter_size",
          "size": [
            "100% - 14px",
            "default"
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle"
        }
      },
      {
        "end_gap@Nova_Client_common.spacer": {
          "$NC_spacer_size": [
            6,
            6
          ]
        }
      }
    ]
  }
}
