{
  "namespace": "Nova_Client_xp_bar_screen",
  "content@Nova_Client_layout.page_body": {
    "$nc_page_toggle": "nc_page_xp_bar",
    "$nc_page_desc": "The experience bar above the hotbar. \"XP Number\" toggles the level number.",
    "$nc_page_req": "",
    "$nc_page_no_req": true,
    "$nc_page_rows": [
      {
        "row_1": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "1@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "xp_number_toggle",
                "$toggle_tags": "$xp_number",
                "$NC_dialog_toggle_text": "XP Number",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "opacity_slider@Nova_Client_common.opacity_slider_section": {
          "$NC_opacity_slider_name": "xp_bar_opacity",
          "$NC_opacity_default_value": "$xp_bar_opacity",
          "$NC_slider_section_offset": [
            0,
            0
          ]
        }
      }
    ]
  }
}
