{
  "namespace": "Nova_Client_xp_screen",
  "content@Nova_Client_layout.page_body": {
    "$nc_page_toggle": "nc_page_xp_calculator",
    "$nc_page_desc": "Shows your XP points, the points you need for the next level and your current level.",
    "$nc_page_req": "",
    "$nc_page_no_req": true,
    "$nc_page_rows": [
      {
        "row_1": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "1@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "xp_point_calculator_icon_toggle",
                "$toggle_tags": "$exp_panel_icon",
                "$NC_dialog_toggle_text": "Icon",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "row_2": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "2@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "xp_panel_point_toggle",
                "$toggle_tags": "$exp_points",
                "$NC_dialog_toggle_text": "EXP Points",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "row_3": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "3@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "xp_panel_level_toggle",
                "$toggle_tags": "$exp_level",
                "$NC_dialog_toggle_text": "EXP Levels",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "row_4": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "4@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "xp_panel_buffer",
                "$toggle_tags": "$exp_panel_buffer",
                "$NC_dialog_toggle_text": "Buffer",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "opacity_slider@Nova_Client_common.opacity_slider_section": {
          "$NC_opacity_slider_name": "exp_calculator_opacity",
          "$NC_opacity_default_value": "$exp_panel_opacity",
          "$NC_slider_section_offset": [
            0,
            0
          ]
        }
      },
      {
        "pos_gap@Nova_Client_common.spacer": {
          "$NC_spacer_size": [
            8,
            8
          ]
        }
      },
      {
        "pos_title": {
          "type": "label",
          "text": "§lPosition & Size",
          "color": [
            1,
            1,
            1
          ],
          "shadow": false,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle"
        }
      },
      {
        "pos_gap2@Nova_Client_common.spacer": {
          "$NC_spacer_size": [
            4,
            4
          ]
        }
      },
      {
        "nc_exp_calculator_x_row@Nova_Client_layout.value_slider": {
          "$nc_vs_name": "nc_exp_calculator_x",
          "$nc_vs_caption": "X",
          "$nc_vs_steps": 101,
          "$nc_vs_cfg": "$exp_calculator_x",
          "$nc_vs_init_expr": "((#slider_steps * 0) + #nc_cfg)",
          "$nc_vs_mul": 1,
          "$nc_vs_add": 0,
          "$nc_vs_unit": "%"
        }
      },
      {
        "nc_exp_calculator_y_row@Nova_Client_layout.value_slider": {
          "$nc_vs_name": "nc_exp_calculator_y",
          "$nc_vs_caption": "Y",
          "$nc_vs_steps": 101,
          "$nc_vs_cfg": "$exp_calculator_y",
          "$nc_vs_init_expr": "((#slider_steps * 0) + #nc_cfg)",
          "$nc_vs_mul": 1,
          "$nc_vs_add": 0,
          "$nc_vs_unit": "%"
        }
      },
      {
        "nc_exp_calculator_size_row@Nova_Client_layout.value_slider": {
          "$nc_vs_name": "nc_exp_calculator_size",
          "$nc_vs_caption": "Size",
          "$nc_vs_steps": 31,
          "$nc_vs_cfg": "$exp_calculator_size",
          "$nc_vs_init_expr": "((((#slider_steps * 0) + #nc_cfg) - 50) / 5)",
          "$nc_vs_mul": 5,
          "$nc_vs_add": 50,
          "$nc_vs_unit": "%"
        }
      },
      {
        "cfg_hint": {
          "type": "label",
          "shadow": false,
          "font_scale_factor": 0.8,
          "color": [
            0.6,
            0.6,
            0.6
          ],
          "text": "Defaults are saved in config.json: exp_calculator_x, exp_calculator_y, exp_calculator_size",
          "size": [
            "100% - 14px",
            "default"
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle"
        }
      },
      {
        "end_gap@Nova_Client_common.spacer": {
          "$NC_spacer_size": [
            6,
            6
          ]
        }
      }
    ]
  }
}
