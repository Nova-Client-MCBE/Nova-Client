{
  "namespace": "Nova_Client_item_counter_screen",
  "content@Nova_Client_layout.page_body": {
    "$nc_page_toggle": "nc_page_item_counter",
    "$nc_page_desc": "Counts the arrows, potions and totems in your whole inventory.",
    "$nc_page_req": "",
    "$nc_page_no_req": true,
    "$nc_page_rows": [
      {
        "row_1": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "1@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "item_counter_arrow",
                "$toggle_tags": "$arrow_counter",
                "$NC_dialog_toggle_text": "Arrows",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "row_2": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "2@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "item_counter_potion",
                "$toggle_tags": "$potion_counter",
                "$NC_dialog_toggle_text": "Potions",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "row_3": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "3@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "item_counter_totem",
                "$toggle_tags": "$totem_counter",
                "$NC_dialog_toggle_text": "Totems",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "opacity_slider@Nova_Client_common.opacity_slider_section": {
          "$NC_opacity_slider_name": "item_counter_opacity",
          "$NC_opacity_default_value": "$item_counter_opacity",
          "$NC_slider_section_offset": [
            0,
            0
          ]
        }
      },
      {
        "pos_gap@Nova_Client_common.spacer": {
          "$NC_spacer_size": [
            8,
            8
          ]
        }
      },
      {
        "pos_title": {
          "type": "label",
          "text": "§lPosition & Size",
          "color": [
            1,
            1,
            1
          ],
          "shadow": false,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle"
        }
      },
      {
        "pos_gap2@Nova_Client_common.spacer": {
          "$NC_spacer_size": [
            4,
            4
          ]
        }
      },
      {
        "nc_item_counter_x_row@Nova_Client_layout.value_slider": {
          "$nc_vs_name": "nc_item_counter_x",
          "$nc_vs_caption": "X",
          "$nc_vs_steps": 101,
          "$nc_vs_cfg": "$item_counter_x",
          "$nc_vs_init_expr": "((#slider_steps * 0) + #nc_cfg)",
          "$nc_vs_mul": 1,
          "$nc_vs_add": 0,
          "$nc_vs_unit": "%"
        }
      },
      {
        "nc_item_counter_y_row@Nova_Client_layout.value_slider": {
          "$nc_vs_name": "nc_item_counter_y",
          "$nc_vs_caption": "Y",
          "$nc_vs_steps": 101,
          "$nc_vs_cfg": "$item_counter_y",
          "$nc_vs_init_expr": "((#slider_steps * 0) + #nc_cfg)",
          "$nc_vs_mul": 1,
          "$nc_vs_add": 0,
          "$nc_vs_unit": "%"
        }
      },
      {
        "nc_item_counter_size_row@Nova_Client_layout.value_slider": {
          "$nc_vs_name": "nc_item_counter_size",
          "$nc_vs_caption": "Size",
          "$nc_vs_steps": 31,
          "$nc_vs_cfg": "$item_counter_size",
          "$nc_vs_init_expr": "((((#slider_steps * 0) + #nc_cfg) - 50) / 5)",
          "$nc_vs_mul": 5,
          "$nc_vs_add": 50,
          "$nc_vs_unit": "%"
        }
      },
      {
        "cfg_hint": {
          "type": "label",
          "shadow": false,
          "font_scale_factor": 0.8,
          "color": [
            0.6,
            0.6,
            0.6
          ],
          "text": "Defaults are saved in config.json: item_counter_x, item_counter_y, item_counter_size",
          "size": [
            "100% - 14px",
            "default"
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle"
        }
      },
      {
        "end_gap@Nova_Client_common.spacer": {
          "$NC_spacer_size": [
            6,
            6
          ]
        }
      }
    ]
  }
}
