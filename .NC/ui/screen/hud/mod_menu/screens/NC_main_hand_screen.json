{
  "namespace": "Nova_Client_main_hand_screen",
  "content@Nova_Client_layout.page_body": {
    "$nc_page_toggle": "nc_page_main_hand",
    "$nc_page_desc": "Shows the item in your selected hotbar slot in its own slot, together with the stack size and the durability. \"Low Durability Warning\" warns you below 10 percent.",
    "$nc_page_req": "",
    "$nc_page_no_req": true,
    "$nc_page_rows": [
      {
        "row_1": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "2@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "mainhand_item_toggle",
                "$toggle_tags": "$mainhand_item",
                "$NC_dialog_toggle_text": "Item",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "row_2": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "3@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "mainhand_stack_toggle",
                "$toggle_tags": "$mainhand_stack",
                "$NC_dialog_toggle_text": "Amount",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "row_3": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "4@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "mainhand_durability_toggle",
                "$toggle_tags": "$mainhand_durability",
                "$NC_dialog_toggle_text": "Durability",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "slot_opacity@Nova_Client_common.opacity_slider_section": {
          "$NC_opacity_slider_name": "mainhand_slot_opacity",
          "$NC_opacity_default_value": "$mainhand_slot_opacity",
          "$NC_slider_section_offset": [
            0,
            0
          ],
          "$NC_opacity_title": "Slot Opacity"
        }
      },
      {
        "bg_opacity@Nova_Client_common.opacity_slider_section": {
          "$NC_opacity_slider_name": "mainhand_percent_opacity",
          "$NC_opacity_default_value": "$mainhand_durability_opacity",
          "$NC_slider_section_offset": [
            0,
            0
          ],
          "$NC_opacity_title": "Durability Opacity"
        }
      },
      {
        "row_mainhand_low_durability": {
          "type": "panel",
          "size": [
            "100%",
            27
          ],
          "controls": [
            {
              "1@Nova_Client_dialog_toggle_template.content": {
                "$toggle_view_binding_name": "mainhand_low_durability",
                "$toggle_tags": "$mainhand_low_durability",
                "$NC_dialog_toggle_text": "Low Durability Warning",
                "$NC_dialog_toggle_anchor": "left_middle",
                "offset": [
                  6,
                  0
                ]
              }
            }
          ]
        }
      },
      {
        "mainhand_warning_opacity_row@Nova_Client_common.opacity_slider_section": {
          "$NC_opacity_slider_name": "mainhand_warning_opacity",
          "$NC_opacity_default_value": "$mainhand_warning_opacity",
          "$NC_slider_section_offset": [
            0,
            0
          ],
          "$NC_opacity_title": "Warning Opacity"
        }
      },
      {
        "pos_gap@Nova_Client_common.spacer": {
          "$NC_spacer_size": [
            8,
            8
          ]
        }
      },
      {
        "pos_title": {
          "type": "label",
          "text": "§lPosition & Size",
          "color": [
            1,
            1,
            1
          ],
          "shadow": false,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle"
        }
      },
      {
        "pos_gap2@Nova_Client_common.spacer": {
          "$NC_spacer_size": [
            4,
            4
          ]
        }
      },
      {
        "nc_mainhand_x_row@Nova_Client_layout.value_slider": {
          "$nc_vs_name": "nc_mainhand_x",
          "$nc_vs_caption": "X",
          "$nc_vs_steps": 101,
          "$nc_vs_cfg": "$mainhand_x",
          "$nc_vs_init_expr": "((#slider_steps * 0) + #nc_cfg)",
          "$nc_vs_mul": 1,
          "$nc_vs_add": 0,
          "$nc_vs_unit": "%"
        }
      },
      {
        "nc_mainhand_y_row@Nova_Client_layout.value_slider": {
          "$nc_vs_name": "nc_mainhand_y",
          "$nc_vs_caption": "Y",
          "$nc_vs_steps": 101,
          "$nc_vs_cfg": "$mainhand_y",
          "$nc_vs_init_expr": "((#slider_steps * 0) + #nc_cfg)",
          "$nc_vs_mul": 1,
          "$nc_vs_add": 0,
          "$nc_vs_unit": "%"
        }
      },
      {
        "nc_mainhand_size_row@Nova_Client_layout.value_slider": {
          "$nc_vs_name": "nc_mainhand_size",
          "$nc_vs_caption": "Size",
          "$nc_vs_steps": 31,
          "$nc_vs_cfg": "$mainhand_size",
          "$nc_vs_init_expr": "((((#slider_steps * 0) + #nc_cfg) - 50) / 5)",
          "$nc_vs_mul": 5,
          "$nc_vs_add": 50,
          "$nc_vs_unit": "%"
        }
      },
      {
        "cfg_hint": {
          "type": "label",
          "shadow": false,
          "font_scale_factor": 0.8,
          "color": [
            0.6,
            0.6,
            0.6
          ],
          "text": "Defaults are saved in config.json: mainhand_x, mainhand_y, mainhand_size",
          "size": [
            "100% - 14px",
            "default"
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle"
        }
      },
      {
        "end_gap@Nova_Client_common.spacer": {
          "$NC_spacer_size": [
            6,
            6
          ]
        }
      }
    ]
  }
}
