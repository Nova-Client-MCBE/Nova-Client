{
  "namespace": "Nova_Client_armor",
  "durability_text": {
    "type": "label",
    "text": "#item_durability_current_amount",
    "shadow": true,
    "layer": 6,
    "size": [
      "default",
      "default"
    ],
    "anchor_from": "center",
    "anchor_to": "center",
    "font_scale_factor": 0.9,
    "color": "$durability_color",
    "$renderer_collection_name|default": "armor_items",
    "bindings": [
      {
        "binding_type": "collection",
        "binding_collection_name": "$renderer_collection_name",
        "binding_name": "#item_durability_current_amount"
      },
      {
        "binding_type": "collection",
        "binding_collection_name": "$renderer_collection_name",
        "binding_name": "#item_durability_total_amount"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#item_durability_current_amount / #item_durability_total_amount) * 100)",
        "target_property_name": "#distribution_durability"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#distribution_durability > $min_durability) and (#distribution_durability < $max_durability) or (#distribution_durability = $max_durability))",
        "target_property_name": "#visible"
      }
    ]
  },
  "durability_panel": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "anchor_from": "center",
    "anchor_to": "center",
    "$renderer_collection_name|default": "armor_items",
    "controls": [
      {
        "red@Nova_Client_armor.durability_text": {
          "$min_durability": 0,
          "$max_durability": 25,
          "$durability_color": [
            1.0,
            0.25,
            0.25
          ]
        }
      },
      {
        "orange@Nova_Client_armor.durability_text": {
          "$min_durability": 25,
          "$max_durability": 50,
          "$durability_color": [
            1.0,
            0.66,
            0.0
          ]
        }
      },
      {
        "yellow@Nova_Client_armor.durability_text": {
          "$min_durability": 50,
          "$max_durability": 75,
          "$durability_color": [
            1.0,
            1.0,
            0.4
          ]
        }
      },
      {
        "green@Nova_Client_armor.durability_text": {
          "$min_durability": 75,
          "$max_durability": 100,
          "$durability_color": [
            0.45,
            1.0,
            0.45
          ]
        }
      }
    ]
  },
  "durability_readout": {
    "type": "panel",
    "size": [
      28,
      12
    ],
    "layer": 6,
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
