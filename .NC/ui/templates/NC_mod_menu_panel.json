{
  "namespace": "Nova_client_modules_menu_button_template",
  "content": {
    "type": "image",
    "texture": "textures/ui/hud_tip_text_background",
    "$nc_letter_ctrl|default": "nc_ltr_all",
    "property_bag": {
      "#nc_kb_off": true,
      "#nc_all": true,
      "#nc_letter": true
    },
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "keyboard_toggle",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#nc_kb_off"
      },
      {
        "binding_type": "view",
        "source_control_name": "nc_ltr_all",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_all"
      },
      {
        "binding_type": "view",
        "source_control_name": "$nc_letter_ctrl",
        "source_property_name": "#toggle_state",
        "target_property_name": "#nc_letter"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#nc_kb_off or #nc_all or #nc_letter)",
        "target_property_name": "#visible"
      }
    ],
    "alpha": 0.6,
    "layer": 2,
    "size": [
      "33%",
      80
    ],
    "controls": [
      {
        "icon": {
          "type": "image",
          "texture": "$modules_template_texture",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [
            "50%",
            "50%"
          ],
          "offset": [
            0,
            -5
          ]
        }
      },
      {
        "button@Nova_client_toggles.Nova_client_toggle": {
          "$button_text": "$modules_template_toggle_text",
          "$font_scale_factor": 0.7,
          "size": "$modules_template_toggle_size",
          "$modules_template_toggle_size|default": [
            "100% - 20px",
            20
          ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "$toggle_name": "nova_modules_toggle",
          "$toggle_tab_focus_binding_name": "#nova_modules_focus_precedence",
          "$toggle_tab_focus_binding_type": "global",
          "$toggle_on_hover_binding_type": "global",
          "$toggle_on_hover_binding_name": "#toggle_on_hover"
        }
      },
      {
        "cog@Nova_client_toggles.Nova_client_toggle": {
          "ignored": "$nc_no_page",
          "$radio_toggle_group": true,
          "$toggle_name": "nc_page_group",
          "$toggle_group_default_selected": 0,
          "$toggle_view_binding_name": "$nc_page_toggle",
          "$toggle_group_forced_index": "$nc_page_index",
          "$button_content": "Nova_client_button.button_icon",
          "$button_icon": "textures/ui/gear",
          "$button_default_tint": [
            0.235,
            0.522,
            0.153
          ],
          "$button_hover_tint": [
            0.322,
            0.647,
            0.208
          ],
          "$button_pressed_tint": [
            0.165,
            0.392,
            0.11
          ],
          "$button_pressed_hover_tint": [
            0.322,
            0.647,
            0.208
          ],
          "size": "$modules_template_button_size",
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right"
        }
      }
    ],
    "$modules_template_button_name|default": "button.menu_select",
    "$nc_no_page|default": false,
    "$nc_page_toggle|default": "nc_page_none",
    "$nc_page_index|default": 99,
    "$modules_template_button_size|default": [
      20,
      20
    ]
  }
}
